# ============================================================
# OC Property Risk Intelligence — Environment Variables
# Copy this file:  cp .env.example .env.local
# Then paste in your keys and set USE_MOCK_DATA=false
# ============================================================

# ── ATTOM Data Solutions  ← PRIMARY (ownership history, liens, foreclosures)
# Free trial: https://api.developer.attomdata.com  (10,000 free calls)
# After signing up, your API key is shown on the dashboard immediately.
ATTOM_API_KEY=your_attom_key_here

# ── Apify  ← SECONDARY (Redfin listing photos, extra property details)
# Free account: https://console.apify.com
# Token location: Console → Settings → Integrations → API tokens
APIFY_API_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=rigelbytes/redfin-scraper

# ── OpenAI  ← AI risk summary paragraphs
# Get key: https://platform.openai.com/api-keys
# Falls back to rule-based summary if not set — optional but recommended.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IMPORTANT: change to false after pasting in your keys above
USE_MOCK_DATA=true
